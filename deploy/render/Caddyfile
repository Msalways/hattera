{
	admin off
}

:{$PORT:10000} {
	encode zstd gzip
	# Older manually configured Render services probe /health. Keep that path
	# tied to backend readiness rather than the renderer's HTML fallback.
	rewrite /health /api/health
	handle /hooks/* {
		reverse_proxy 127.0.0.1:8800
	}
	handle {
		reverse_proxy 127.0.0.1:8799 {
			header_up X-Forwarded-Proto https
			flush_interval -1
		}
	}
}
