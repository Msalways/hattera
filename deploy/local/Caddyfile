:80 {
	map {host} {upstream_scheme} {
		{$OMB_HTTPS_HOST:https-disabled.invalid} {$OMB_UPSTREAM_SCHEME:http}
		default http
	}
	encode zstd gzip
	handle /hooks/* {
		reverse_proxy 127.0.0.1:8800
	}
	handle {
		reverse_proxy 127.0.0.1:8799 {
			header_up X-Forwarded-Proto {upstream_scheme}
			flush_interval -1
		}
	}
}

# The Codex CLI binds 127.0.0.1:1455 inside the container. Listen only on
# its Docker-network address so the CLI can keep that loopback socket. Compose
# publishes this listener only on the host's 127.0.0.1.
:1455 {
	bind {$OMB_CODEX_CALLBACK_BIND}
	@callback {
		path /auth/callback
		method GET
	}
	handle @callback {
		reverse_proxy 127.0.0.1:1455
	}
	respond 404
}
