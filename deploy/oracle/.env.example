# Copy to deploy/oracle/.env. Keep that file private.
COMPOSE_PROJECT_NAME=hattera
OMB_LOCAL_IMAGE=hattera-oracle:local
OMB_BIND_ADDRESS=127.0.0.1
OMB_HTTP_PORT=8080
# Engine CLIs are installed from Manage AI accounts only when requested.
ENGINES=

# Local test: use http://127.0.0.1:8080 and leave OMB_HTTPS_HOST empty.
# Private Oracle VM: use the same https://<machine>.<tailnet>.ts.net origin below.
OMB_PUBLIC_URL=http://127.0.0.1:8080
OMB_HTTPS_HOST=
GITHUB_REDIRECT_URI=http://127.0.0.1:8080/identity/callback/github
# Optional public mode: set this to a domain for public.compose.yaml, or the
# VM's public IPv4 address for public-ip.compose.yaml. Match both HTTPS URLs.
OMB_PUBLIC_HOST=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OWNER_ID=
BETTER_AUTH_SECRET=

# Generate a URL-safe random value; this also becomes part of DATABASE_URL.
POSTGRES_PASSWORD=
