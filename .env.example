# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=openmausbot
OMB_BIND_ADDRESS=127.0.0.1
OMB_HTTP_PORT=8080
# Name shown on the connection page; defaults to Hattera server.
OMB_ENVIRONMENT_LABEL=
# Leave empty to use http://localhost:${OMB_HTTP_PORT:-8080}.
# For local GitHub sign-in, use http://127.0.0.1:${OMB_HTTP_PORT:-8080}.
OMB_PUBLIC_URL=
# Leave empty to inherit OMB_PUBLIC_URL.
OMB_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set OMB_PUBLIC_URL to https:// followed by the same hostname.
# Requires OMB_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
OMB_HTTPS_HOST=
OMB_LOCAL_IMAGE=openmausbot-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex opencode-ai cline"
# GitHub OAuth for /identity/*; register GITHUB_REDIRECT_URI in the GitHub OAuth app.
# Use either the same Tailscale HTTPS origin or HTTP 127.0.0.1 with a port.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BETTER_AUTH_SECRET=
GITHUB_OWNER_ID=
GITHUB_REDIRECT_URI=
# Optional PostgreSQL records. A fresh installation starts with an empty
# database. DATABASE_URL may point to any compatible PostgreSQL provider.
# The /data volume is still required for uploads, workspaces and CLI homes.
OMB_POSTGRES_ENABLED=false
DATABASE_URL=
# An absolute path inside durable mounted storage when PostgreSQL is enabled.
OMB_POSTGRES_FILES_DIR=/data/.openmausbot-postgres
# Leave empty for <COMPOSE_PROJECT_NAME>_data. Set a pre-created Docker volume
# name and OMB_DATA_EXTERNAL=true for a different volume or volume driver.
OMB_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
OMB_DATA_EXTERNAL=false
# Optional offsite copies of attachments and encrypted workspace backup
# exports. Supports any S3-compatible private bucket. Keep the /data volume:
# bot workspaces, CLI homes, and other files still need a filesystem.
OMB_OBJECT_STORAGE_KIND=local
OMB_S3_BUCKET=
OMB_S3_REGION=
OMB_S3_ENDPOINT=
OMB_S3_PREFIX=hattera
OMB_S3_FORCE_PATH_STYLE=true
OMB_S3_ACCESS_KEY_ID=
OMB_S3_SECRET_ACCESS_KEY=
